SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

APP_HOST=localhost:3003
# Apex / parent domain for multi-tenant hosts (no scheme or path).
# Local: vowd.localhost resolves to 127.0.0.1 in modern browsers (no /etc/hosts).
# Platform: http://vowd.localhost:3003  ·  Wedding: http://{slug}.vowd.localhost:3003
# Production apex: vowd.site
APP_BASE_DOMAIN=vowd.localhost
# Optional port appended when building absolute wedding admin URLs in local env.
APP_PORT=3003

# Object storage (Cloudflare R2, S3-compatible). When BUCKET_NAME and AWS keys are
# set, the app uses the bucket in every environment. Set this to "local" to force
# disk storage under public/uploads/ instead.
# DISPOSABLE_CAMERA_STORAGE=local

BUCKET_NAME=vowd
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Region must be "auto" for R2
AWS_REGION=auto
# Account API host only — do not append the bucket name as a path segment.
AWS_ENDPOINT_URL_S3=https://your-cloudflare-account-id.r2.cloudflarestorage.com
# Optional alternative to AWS_ENDPOINT_URL_S3: derive the same URL from the account id.
# R2_ACCOUNT_ID=your-cloudflare-account-id
