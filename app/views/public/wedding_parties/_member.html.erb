<% delay_class = ["", "animation-delay-200", "animation-delay-400", "animation-delay-400"][index % 4] %>
<% group = local_assigns.fetch(:group, "bridesmaids") %>

<div class="text-center animate-on-scroll <%= delay_class %>" data-scroll-animate-target="item">
  <%= editor_panel("wedding_party") do %>
    <div class="w-40 h-40 rounded-full overflow-hidden mx-auto mb-6 border-2 border-hairline shadow-md">
      <% if (src = wedding_asset_url(current_wedding.party_member_image(person))).present? %>
        <%= image_tag src, alt: person["name"], class: "w-full h-full object-cover" %>
      <% else %>
        <div class="w-full h-full bg-hairline"></div>
      <% end %>
    </div>
    <%= editor_text("wedding_party.#{group}.#{index}.role", tag: :p, css_class: "wedding-meta mb-1") do %>
      <%= person["role"] %>
    <% end %>
    <%= editor_text("wedding_party.#{group}.#{index}.name", tag: :h3, css_class: "font-theme-display text-2xl text-ink mb-1") do %>
      <%= person["name"] %>
    <% end %>
    <%= editor_text("wedding_party.#{group}.#{index}.relation", tag: :p, css_class: "text-sm text-ink-soft font-light italic") do %>
      <%= person["relation"] %>
    <% end %>
  <% end %>
</div>
