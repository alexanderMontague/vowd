<%
  # Decorative echoes of photos shown elsewhere — hidden from assistive tech.
  # On narrow screens they peek from the card edges without covering copy;
  # on wide screens they scatter beside the invitation.
  layers = floating_photo_layers(local_assigns.fetch(:assets, []))
%>
<% if layers.any? %>
  <div class="floating-photos" aria-hidden="true" data-controller="parallax">
    <% layers.each_with_index do |(asset, speed), index| %>
      <figure class="floating-photo floating-photo--<%= index + 1 %>"
        data-parallax-target="layer" data-parallax-speed="<%= speed %>">
        <%= image_tag wedding_asset_url(asset), alt: "", loading: "lazy", decoding: "async" %>
      </figure>
    <% end %>
  </div>
<% end %>
