<%
  asset = local_assigns[:asset]
  caption = local_assigns[:caption]
  wrapper_class = local_assigns.fetch(:wrapper_class, "")
%>
<% if asset.present? %>
  <figure class="vase-photo <%= wrapper_class %>">
    <div class="vase-photo__arch">
      <%= image_tag wedding_asset_url(asset),
          class: "vase-photo__image", alt: wedding_asset_alt(asset),
          loading: "lazy", decoding: "async" %>
    </div>
    <%= image_tag "decor/urn-pedestal.webp",
        class: "vase-photo__urn", alt: "", aria: { hidden: true },
        loading: "lazy", decoding: "async" %>
    <% if caption.present? %>
      <figcaption class="vase-photo__caption"><%= caption %></figcaption>
    <% end %>
  </figure>
<% end %>
