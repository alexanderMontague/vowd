<div class="wedding-page-wash min-h-screen flex items-center justify-center px-4 py-20">
  <div class="max-w-md w-full bg-surface-alt shadow-xl p-12 text-center border border-hairline animate-scale-in">
    <%# Check Icon %>
    <div class="inline-flex items-center justify-center w-20 h-20 border border-hairline-strong rounded-full mb-8 bg-surface">
      <%= render "public/shared/icon", name: "check" %>
    </div>

    <h1 class="text-5xl mb-6 font-theme-display font-light text-ink">
      Thank You
    </h1>

    <p class="mb-8 leading-relaxed wedding-prose">
      We have received your response and look forward to celebrating with you.
    </p>

    <%= render "public/shared/divider", height: 8 %>
    <div class="mb-8"></div>

    <p class="text-sm mb-8 text-ink-soft font-light">
      <%= current_wedding.title %>
      <% if current_wedding.date %>
        <br>
        <span class="text-xs"><%= format_date(current_wedding.date) %></span>
      <% end %>
    </p>

    <div class="space-y-4">
      <%= link_to "Return to Wedding Page", root_path,
          class: "text-xs uppercase tracking-wider text-ink-muted no-underline hover:text-ink transition-colors" %>
    </div>
  </div>
</div>
