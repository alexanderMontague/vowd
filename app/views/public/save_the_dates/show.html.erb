<%= render layout: "public/shared/full_width_invitation_video" do %>
  <% copy = current_wedding.save_the_date %>
  <div class="invitation-video-content hidden min-h-screen px-4 py-10 md:py-20"
       data-invitation-video-target="content">
    <%= render "public/shared/invitation_frame",
        floating_assets: current_wedding.placements_for("save_the_date_floating"),
        floating_slot: "save_the_date_floating" do %>
      <%= render "public/shared/invitation_hero",
          eyebrow: copy["eyebrow"],
          eyebrow_field: "save_the_date_copy.eyebrow",
          title: current_wedding.title %>

      <% if flash[:notice].present? || flash[:alert].present? %>
        <div data-controller="scroll-to-top">
          <%= render "public/shared/flash_messages" %>
        </div>
      <% end %>

      <div class="space-y-10 text-center">
        <%= render decor_partial("framed_photo"),
            asset: current_wedding.placement("save_the_date_portrait"),
            slot: "save_the_date_portrait" %>

        <%= editor_text("save_the_date_copy.announcement", tag: :p, css_class: "mx-auto max-w-md wedding-prose", multiline: true) do %>
          <%= copy["announcement"] %>
        <% end %>

        <% if current_wedding.date %>
          <div class="invitation-when"
               data-controller="countdown"
               data-countdown-target-time-value="<%= wedding_datetime_iso(current_wedding) %>">
            <div class="border-y border-accent/30 py-8">
              <%= editor_essentials(tag: :p, css_class: "mb-2 font-theme-display text-3xl font-light text-ink md:text-4xl") do %>
                <%= format_date_elegant(current_wedding.date) %>
              <% end %>
              <% if current_wedding.ceremony_time.present? %>
                <%= editor_essentials(tag: :p, css_class: "text-lg wedding-prose") do %>
                  <%= format_time_elegant(current_wedding.ceremony_time) || current_wedding.ceremony_time %>
                <% end %>
              <% end %>
            </div>

            <div class="countdown" aria-live="polite" aria-label="Countdown to wedding day">
              <div class="countdown-unit">
                <span class="countdown-value" data-countdown-target="days">—</span>
                <span class="countdown-label">Days</span>
              </div>
              <div class="countdown-unit">
                <span class="countdown-value" data-countdown-target="hours">—</span>
                <span class="countdown-label">Hours</span>
              </div>
              <div class="countdown-unit">
                <span class="countdown-value" data-countdown-target="minutes">—</span>
                <span class="countdown-label">Minutes</span>
              </div>
              <div class="countdown-unit">
                <span class="countdown-value" data-countdown-target="seconds">—</span>
                <span class="countdown-label">Seconds</span>
              </div>
            </div>
          </div>
        <% end %>

        <%= editor_essentials(tag: :div, css_class: "space-y-1") do %>
          <% if current_wedding.venue %>
            <p class="wedding-prose"><%= current_wedding.venue['name'] %></p>
            <p class="text-sm font-light text-ink-soft">
              <%= full_venue_name(current_wedding.venue) %>
            </p>
          <% end %>
        <% end %>

        <%= render decor_partial("vase_photo"),
            asset: current_wedding.placement("save_the_date_vase"),
            slot: "save_the_date_vase" %>

        <div class="flex flex-col items-center gap-4 text-center">
          <% if current_wedding&.date %>
            <%= editor_text("save_the_date_copy.calendar_button_text", tag: :div, css_class: "w-full") do %>
              <%= link_to copy["calendar_button_text"].presence || "Add to Calendar",
                  calendar_url,
                  target: "_blank",
                  rel: "noopener noreferrer",
                  class: "btn-wedding-primary inline-block" %>
            <% end %>
          <% end %>
          <%= editor_text("save_the_date_copy.formal_note", tag: :p, css_class: "text-xs font-light text-ink-faint") do %>
            <%= copy["formal_note"] %>
          <% end %>
        </div>

        <div class="mx-auto max-w-md space-y-8 border-t border-accent/30 pt-10">
          <div class="space-y-2 text-center">
            <%= editor_text("save_the_date_copy.signup_eyebrow", tag: :p, css_class: "invitation-eyebrow") do %>
              <%= copy["signup_eyebrow"] %>
            <% end %>
            <%= editor_text("save_the_date_copy.signup_prompt", tag: :p, css_class: "mx-auto max-w-sm wedding-prose", multiline: true) do %>
              <%= copy["signup_prompt"] %>
            <% end %>
          </div>

          <%= form_with url: public_save_the_date_signup_path,
                        scope: :save_the_date_signup,
                        method: :post,
                        data: { turbo: false },
                        class: "space-y-6 text-left" do |f| %>
            <div>
              <%= f.label :name, "Name", class: "rsvp-label" %>
              <%= f.text_field :name,
                  class: "rsvp-input",
                  placeholder: "Your name",
                  autocomplete: "name" %>
            </div>

            <div>
              <%= f.label :email, "Email", class: "rsvp-label" %>
              <%= f.email_field :email,
                  required: true,
                  class: "rsvp-input",
                  placeholder: "you@example.com",
                  autocomplete: "email" %>
            </div>

            <div>
              <%= f.label :phone_number, "Phone (optional)", class: "rsvp-label" %>
              <%= f.telephone_field :phone_number,
                  class: "rsvp-input",
                  placeholder: "(555) 555-5555",
                  autocomplete: "tel" %>
            </div>

            <div class="pt-2 flex justify-center">
              <%= editor_text("save_the_date_copy.submit_button_text", tag: :span, css_class: "inline-block") do %>
                <%= f.submit copy["submit_button_text"].presence || "Share My Details", class: "btn-wedding-primary" %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
