<div class="min-h-screen">
  <%= render "public/shared/page_header",
      title: current_wedding.faq["title"],
      subtitle: current_wedding.faq["subtitle"],
      title_field: "faq.title",
      subtitle_field: "faq.subtitle" %>

  <section class="px-4 pb-24">
    <div class="mx-auto max-w-3xl">
      <%= editor_panel("faq", tag: :div, css_class: "bg-surface-alt shadow-xl border border-hairline divide-y divide-hairline animate-fade-in-up") do %>
        <% Array(current_wedding.faq["questions"]).each_with_index do |item, index| %>
          <details class="group px-8 md:px-12" <%= "open" if site_editor_active? %>>
            <summary class="flex items-center justify-between gap-6 py-7 cursor-pointer list-none">
              <%= editor_text("faq.questions.#{index}.question", tag: :span, css_class: "font-theme-display text-xl font-light text-ink") do %>
                <%= item["question"] %>
              <% end %>
              <span class="flex-shrink-0 text-ink-faint transition-transform duration-300 group-open:rotate-180">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
                </svg>
              </span>
            </summary>
            <%= editor_text("faq.questions.#{index}.answer", tag: :div, css_class: "pb-7 text-ink-soft font-light leading-relaxed text-base", multiline: true) do %>
              <%= item["answer"] %>
            <% end %>
          </details>
        <% end %>
      <% end %>

      <div class="mt-10 text-center">
        <%= link_to "← Return Home", root_path, class: "text-sm text-ink-faint font-light tracking-wider hover:text-ink-muted transition-colors" %>
      </div>
    </div>
  </section>
</div>
