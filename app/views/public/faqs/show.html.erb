<div class="min-h-screen">
  <%= render "public/shared/page_header",
      title: current_wedding.faq["title"],
      subtitle: current_wedding.faq["subtitle"] %>

  <section class="px-4 pb-24">
    <div class="mx-auto max-w-3xl">
      <div class="bg-surface-alt shadow-xl border border-hairline divide-y divide-hairline animate-fade-in-up" style="animation-delay: 0.2s;">
        <% current_wedding.faq["questions"]&.each do |item| %>
          <details class="group px-8 md:px-12">
            <summary class="flex items-center justify-between gap-6 py-7 cursor-pointer list-none">
              <span class="font-theme-display text-xl font-light text-ink">
                <%= item["question"] %>
              </span>
              <span class="flex-shrink-0 text-ink-faint transition-transform duration-300 group-open:rotate-180">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
                </svg>
              </span>
            </summary>
            <div class="pb-7 text-ink-soft font-light leading-relaxed text-base">
              <%= item["answer"] %>
            </div>
          </details>
        <% end %>
      </div>

      <div class="mt-10 text-center">
        <%= link_to "← Return Home", root_path, class: "text-sm text-ink-faint font-light tracking-wider hover:text-ink-muted transition-colors" %>
      </div>
    </div>
  </section>
</div>
