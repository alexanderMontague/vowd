<div class="min-h-screen" data-controller="scroll-animate">
  <section class="wedding-hero">
    <%= editor_slot("homepage_hero", css_class: "wedding-hero-slot") do %>
      <% hero_src = wedding_asset_url(current_wedding.hero_image) %>
      <% if hero_src.present? %>
        <%= image_tag hero_src,
            alt: current_wedding.title,
            class: "wedding-hero-image" %>
      <% else %>
        <div class="wedding-hero-image bg-ink"></div>
      <% end %>
    <% end %>
    <div class="wedding-hero-overlay"></div>
    <div class="wedding-hero-content">
      <div class="text-center px-4 animate-fade-in-up">
        <div class="mb-8 animate-scale-in">
          <div class="w-px h-16 bg-white/30 mx-auto mb-8"></div>
        </div>
        <%= editor_essentials(tag: :h1, css_class: "wedding-hero-title text-white") do %>
          <%= current_wedding.title %>
        <% end %>
        <div class="wedding-divider-horizontal w-24 mb-8 animate-grow-width"></div>
        <%= editor_text("hero.tagline", tag: :p, css_class: "wedding-hero-subtitle text-white") do %>
          <%= current_wedding.hero["tagline"] %>
        <% end %>
        <div class="space-y-3 text-base font-light tracking-wider text-white">
          <% if current_wedding.date %>
            <%= editor_essentials(tag: :p) do %>
              <%= format_date_elegant(current_wedding.date) %>
            <% end %>
          <% end %>
          <%= editor_essentials(tag: :p, css_class: "text-sm opacity-80") do %>
            <%= full_venue_name(current_wedding.venue) %>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <% if current_wedding.story["enabled"] || site_editor_active? %>
    <%= editor_panel("home_settings", tag: :section, css_class: "max-w-4xl mx-auto py-32 px-4") do %>
      <div class="text-center animate-on-scroll" data-scroll-animate-target="item">
        <%= render "public/shared/divider" %>
        <div class="mb-12"></div>
        <%= render "public/shared/section_title", title: current_wedding.story["title"], field: "story.title" %>
        <div class="space-y-8 leading-loose text-lg wedding-prose max-w-2xl mx-auto">
          <% Array(current_wedding.story["paragraphs"]).each_with_index do |paragraph, index| %>
            <%= editor_text("story.paragraphs.#{index}", tag: :p, multiline: true) do %>
              <%= paragraph %>
            <% end %>
          <% end %>
        </div>
        <% if current_wedding.story["closing"].present? || site_editor_active? %>
          <%= editor_text("story.closing", tag: :p, css_class: "italic text-base text-ink-soft mt-8") do %>
            <%= current_wedding.story["closing"] %>
          <% end %>
        <% end %>
        <div class="mt-16"></div>
        <%= render "public/shared/divider" %>
      </div>
    <% end %>
  <% end %>

  <section class="wedding-band py-32" id="events">
    <div class="max-w-6xl mx-auto px-4">
      <%= render "public/shared/section_title", title: "Event Details", centered: true %>
      <div class="mb-24"></div>
      <div class="grid md:grid-cols-3 gap-20">
        <%= render "public/shared/event_detail", icon: "calendar", title: "Date" do %>
          <%= editor_essentials do %>
            <% if current_wedding.date %>
              <p class="wedding-prose"><%= current_wedding.date.strftime("%A") %></p>
              <p class="wedding-prose"><%= format_date(current_wedding.date) %></p>
            <% end %>
          <% end %>
        <% end %>

        <%= render "public/shared/event_detail", icon: "clock", title: "Time", delay_class: "animation-delay-200" do %>
          <%= editor_essentials do %>
            <p class="wedding-prose">Ceremony at <%= current_wedding.ceremony_time %></p>
            <p class="wedding-prose text-sm opacity-70">Reception to Follow</p>
          <% end %>
        <% end %>

        <%= render "public/shared/event_detail", icon: "map_pin", title: "Venue", delay_class: "animation-delay-400" do %>
          <%= editor_essentials do %>
            <p class="wedding-prose"><%= current_wedding.venue["name"] %></p>
            <p class="wedding-prose text-sm opacity-70">
              <%= full_venue_name(current_wedding.venue) %>
            </p>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

  <% if @events.any? %>
    <section class="py-32 px-4">
      <div class="max-w-4xl mx-auto">
        <%= render "public/shared/divider" %>
        <div class="mb-12"></div>
        <%= render "public/shared/section_title", title: "Schedule", centered: true %>
        <div class="space-y-8">
          <% @events.each do |event| %>
            <div class="wedding-card animate-on-scroll" data-scroll-animate-target="item">
              <h3 class="text-2xl mb-2 font-theme-display text-ink">
                <%= event.name %>
              </h3>
              <% if event.datetime %>
                <p class="text-sm tracking-wider uppercase mb-4 text-ink-soft font-light">
                  <%= event.datetime.strftime("%I:%M %p") %>
                </p>
              <% end %>
              <% if event.location.present? %>
                <p class="wedding-prose"><%= event.location %></p>
              <% end %>
              <% if event.description.present? %>
                <p class="mt-4 text-ink-soft font-light"><%= event.description %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <% if current_wedding.homepage_gallery_visible? || site_editor_active? %>
    <% homepage_images = current_wedding.homepage_gallery_images %>
    <%= editor_panel("home_settings", tag: :section, css_class: "py-32") do %>
      <div class="max-w-7xl mx-auto px-4">
        <%= render "public/shared/divider" %>
        <div class="mb-12"></div>
        <%= render "public/shared/section_title",
            title: current_wedding.gallery_content["homepage_title"],
            centered: true,
            field: "photos_page.homepage_title" %>
        <div class="mb-24"></div>
        <div class="grid md:grid-cols-3 gap-8">
          <% homepage_images.each_with_index do |image, index| %>
            <% delay_class = index == 1 ? "animation-delay-200" : (index == 2 ? "animation-delay-400" : "") %>
            <div class="gallery-item animate-on-scroll <%= delay_class %>" data-scroll-animate-target="item">
              <%= image_tag wedding_asset_url(image), alt: wedding_asset_alt(image), loading: "lazy" %>
            </div>
          <% end %>
        </div>
        <% if site_navigation.visible?("gallery") %>
          <div class="text-center mt-16">
            <%= link_to "View All Photos", public_photos_path, class: "btn-wedding-primary" %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if site_navigation.visible?("rsvp") %>
    <section class="wedding-band py-32" id="rsvp-section">
      <div class="max-w-2xl mx-auto px-4 text-center">
        <%= render "public/shared/divider" %>
        <div class="mb-12"></div>
        <%= render "public/shared/section_title", title: current_wedding.rsvp["title"], field: "rsvp_copy.title" %>
        <%= editor_text("rsvp_copy.description", tag: :p, css_class: "text-lg mb-12 max-w-lg mx-auto leading-relaxed wedding-prose", multiline: true) do %>
          <%= current_wedding.rsvp["description"] %>
        <% end %>
        <%= editor_link("rsvp_copy.button_text",
            href: public_rsvp_lookup_path,
            css_class: "btn-wedding-primary") do %>
          <%= current_wedding.rsvp["button_text"] %>
        <% end %>
        <%= editor_text("rsvp_copy.lookup_hint", tag: :p, css_class: "text-sm tracking-wider mt-8 text-ink-faint font-light") do %>
          <%= current_wedding.rsvp["lookup_hint"] %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
