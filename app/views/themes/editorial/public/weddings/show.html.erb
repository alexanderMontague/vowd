<%
  hero_src = wedding_asset_url(current_wedding.hero_image)
  story = current_wedding.story
  story_plate = current_wedding.placement("save_the_date_portrait")
  venue = current_wedding.venue

  # Sections number themselves in document order, so toggling one off does not leave
  # a gap in the sequence.
  section_number = 0
  next_number = -> { section_number += 1 }
%>

<div data-controller="scroll-animate">
  <%# ----------------------------------------------------------------------------
      Cover — the photograph is a plate, and the masthead sits beneath it. Nothing
      is ever set over an image, so legibility never depends on the photo.
      ---------------------------------------------------------------------------- %>
  <header class="editorial-cover">
    <div class="editorial-shell pt-10">
      <div class="editorial-cover__frame">
        <% if hero_src.present? %>
          <%= image_tag hero_src, alt: current_wedding.title %>
        <% end %>
      </div>

      <div class="editorial-cover__masthead">
        <div>
          <p class="editorial-label mb-6">
            <%= current_wedding.hero["eyebrow"].presence || "The Wedding Issue" %>
          </p>
          <h1 class="editorial-headline"><%= current_wedding.title %></h1>
        </div>

        <% if current_wedding.date %>
          <p class="editorial-label text-ink lg:text-right">
            <%= format_date_short(current_wedding.date) %>
          </p>
        <% end %>
      </div>

      <div class="editorial-colophon">
        <% if current_wedding.hero["tagline"].present? %>
          <p class="editorial-caption flex-1"><%= current_wedding.hero["tagline"] %></p>
        <% end %>
        <p class="editorial-caption"><%= full_venue_name(venue) %></p>
        <% if current_wedding.ceremony_time.present? %>
          <p class="editorial-caption">Ceremony <%= current_wedding.ceremony_time %></p>
        <% end %>
      </div>
    </div>
  </header>

  <%# Story %>
  <% if story["enabled"] %>
    <section class="editorial-shell editorial-section">
      <div class="editorial-grid">
        <div class="editorial-rail">
          <%= render "public/shared/marker", number: next_number.call, label: "Our Story" %>
        </div>

        <div class="animate-on-scroll" data-scroll-animate-target="item">
          <h2 class="editorial-title mb-10"><%= story["title"] %></h2>
          <div class="editorial-body">
            <% Array(story["paragraphs"]).each do |paragraph| %>
              <p><%= paragraph %></p>
            <% end %>
          </div>
          <% if story["closing"].present? %>
            <p class="editorial-caption mt-10 border-t pt-6" style="border-color: var(--editorial-rule);">
              <%= story["closing"] %>
            </p>
          <% end %>
        </div>
      </div>
    </section>

    <% if (plate_src = wedding_asset_url(story_plate)).present? %>
      <figure class="editorial-plate m-0">
        <%= image_tag plate_src, alt: wedding_asset_alt(story_plate), loading: "lazy" %>
      </figure>
    <% end %>
  <% end %>

  <%# Details %>
  <section class="editorial-shell editorial-section" id="events">
    <div class="editorial-grid">
      <div class="editorial-rail">
        <%= render "public/shared/marker", number: next_number.call, label: "The Day" %>
      </div>

      <dl class="grid gap-x-10 gap-y-10 sm:grid-cols-3">
        <div>
          <dt class="editorial-label mb-3">Date</dt>
          <dd class="editorial-title text-2xl">
            <% if current_wedding.date %>
              <%= format_date(current_wedding.date) %>
            <% end %>
          </dd>
          <% if current_wedding.date %>
            <p class="editorial-caption mt-2"><%= current_wedding.date.strftime("%A") %></p>
          <% end %>
        </div>

        <div>
          <dt class="editorial-label mb-3">Time</dt>
          <dd class="editorial-title text-2xl"><%= current_wedding.ceremony_time %></dd>
          <p class="editorial-caption mt-2">Reception to follow</p>
        </div>

        <div>
          <dt class="editorial-label mb-3">Place</dt>
          <dd class="editorial-title text-2xl"><%= venue["name"] %></dd>
          <p class="editorial-caption mt-2"><%= full_venue_name(venue) %></p>
        </div>
      </dl>
    </div>
  </section>

  <%# Schedule %>
  <% if @events.any? %>
    <section class="editorial-shell editorial-section">
      <div class="editorial-grid">
        <div class="editorial-rail">
          <%= render "public/shared/marker", number: next_number.call, label: "Schedule" %>
        </div>

        <div>
          <% @events.each do |event| %>
            <div class="editorial-listing animate-on-scroll" data-scroll-animate-target="item">
              <p class="editorial-listing__time">
                <%= event.datetime&.strftime("%l:%M %p")&.strip %>
              </p>
              <div>
                <h3 class="editorial-listing__name"><%= event.name %></h3>
                <% if event.description.present? %>
                  <p class="editorial-caption mt-2"><%= event.description %></p>
                <% end %>
              </div>
              <% if event.location.present? %>
                <p class="editorial-label text-ink-faint sm:text-right"><%= event.location %></p>
              <% end %>
            </div>
          <% end %>
          <div class="editorial-rule"></div>
        </div>
      </div>
    </section>
  <% end %>

  <%# Gallery %>
  <% if current_wedding.homepage_gallery_visible? %>
    <section class="editorial-section">
      <div class="editorial-shell">
        <div class="editorial-grid">
          <div class="editorial-rail">
            <%= render "public/shared/marker", number: next_number.call, label: "Portfolio" %>
          </div>

          <div>
            <h2 class="editorial-title mb-10">
              <%= current_wedding.gallery_content["homepage_title"] %>
            </h2>

            <div class="editorial-filmstrip">
              <% current_wedding.homepage_gallery_images.each do |image| %>
                <figure>
                  <%= image_tag wedding_asset_url(image),
                      alt: wedding_asset_alt(image),
                      loading: "lazy" %>
                </figure>
              <% end %>
            </div>

            <% if site_navigation.visible?("gallery") %>
              <%= link_to "See the full portfolio", public_photos_path,
                  class: "editorial-label border-b border-accent pb-1 text-ink hover:text-accent" %>
            <% end %>
          </div>
        </div>
      </div>
    </section>
  <% end %>

  <%# RSVP %>
  <% if site_navigation.visible?("rsvp") %>
    <section class="editorial-cta" id="rsvp-section">
      <div class="editorial-shell">
        <div class="editorial-grid">
          <div class="editorial-rail">
            <%= render "public/shared/marker", number: next_number.call, label: "Attendance" %>
          </div>

          <div>
            <h2 class="editorial-title mb-8"><%= current_wedding.rsvp["title"] %></h2>
            <p class="editorial-standfirst mb-12"><%= current_wedding.rsvp["description"] %></p>
            <%= link_to current_wedding.rsvp["button_text"], public_rsvp_lookup_path,
                class: "btn-wedding-primary" %>
            <p class="editorial-caption mt-8"><%= current_wedding.rsvp["lookup_hint"] %></p>
          </div>
        </div>
      </div>
    </section>
  <% end %>
</div>
