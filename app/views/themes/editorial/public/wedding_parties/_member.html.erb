<% group = local_assigns.fetch(:group, "bridesmaids") %>

<div class="animate-on-scroll" data-scroll-animate-target="item">
  <%= editor_panel("wedding_party") do %>
    <div class="editorial-contributor__portrait">
      <% if (src = wedding_asset_url(current_wedding.party_member_image(person))).present? %>
        <%= image_tag src, alt: person["name"], loading: "lazy" %>
      <% else %>
        <div class="editorial-contributor__initial"><%= person["name"].to_s.first %></div>
      <% end %>
    </div>

    <%= editor_text("wedding_party.#{group}.#{index}.role", tag: :p, css_class: "editorial-label mb-2") do %>
      <%= person["role"] %>
    <% end %>
    <%= editor_text("wedding_party.#{group}.#{index}.name", tag: :h3, css_class: "editorial-contributor__name") do %>
      <%= person["name"] %>
    <% end %>
    <%= editor_text("wedding_party.#{group}.#{index}.relation", tag: :p, css_class: "editorial-caption mt-1") do %>
      <%= person["relation"] %>
    <% end %>
  <% end %>
</div>
