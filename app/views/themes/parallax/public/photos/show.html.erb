<%
  gallery = current_wedding.gallery_content
  sections = current_wedding.gallery_sections
%>

<div data-controller="scroll-animate parallax">
  <%= render "public/shared/page_header",
      title: gallery["title"],
      subtitle: gallery["subtitle"],
      title_field: "photos_page.title",
      subtitle_field: "photos_page.subtitle" %>

  <% sections.each_with_index do |section, index| %>
    <section class="parallax-section parallax-stage <%= "parallax-section--band" if index.odd? %>">
      <div class="parallax-stage__ornaments">
        <%# Alternating sides keeps a long gallery from feeling like a repeating pattern. %>
        <% if index.even? %>
          <%= render "public/shared/ornament",
              name: "roses-top-left",
              css_class: "-left-24 top-0 hidden h-72 w-72 lg:block",
              speed: 0.18,
              opacity: 0.35 %>
        <% else %>
          <%= render "public/shared/ornament",
              name: "roses-bottom-right",
              css_class: "-right-24 bottom-0 hidden h-72 w-72 lg:block",
              speed: -0.18,
              opacity: 0.35 %>
        <% end %>
      </div>

      <div class="parallax-stage__content max-w-7xl">
        <div class="mb-16 text-center">
          <p class="parallax-details__label">Chapter <%= index + 1 %></p>
          <%= render "public/shared/section_title", title: section["title"], centered: true %>
        </div>

        <div class="parallax-gallery">
          <% Array(section["images"]).each do |image| %>
            <figure class="animate-on-scroll" data-scroll-animate-target="item">
              <%= image_tag wedding_asset_url(image),
                  alt: wedding_asset_alt(image),
                  loading: "lazy" %>
            </figure>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <% if current_wedding.dispo_gallery_visible? %>
    <section id="dispo-photos"
             class="parallax-section parallax-stage <%= "parallax-section--band" if sections.length.odd? %>">
      <div class="parallax-stage__content max-w-7xl">
        <div class="mb-16 text-center">
          <p class="parallax-details__label">Shot by our guests</p>
          <%= render "public/shared/section_title", title: "From the Disposable Camera", centered: true %>
        </div>

        <% if @dispo_total.to_i.zero? %>
          <p class="py-16 text-center wedding-meta">
            Photos will appear here after the wedding.
          </p>
        <% else %>
          <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4"
               data-photo-style="<%= current_wedding.dispo_photo_style %>">
            <% @dispo_photos.each do |photo| %>
              <div class="animate-on-scroll" data-scroll-animate-target="item">
                <%= render "dispo/shared/photo", photo: photo %>
              </div>
            <% end %>
          </div>

          <div class="mt-16 flex flex-col items-center gap-4">
            <% if @dispo_has_more %>
              <p class="wedding-meta">
                Showing <%= @dispo_photos.size %> of <%= pluralize(@dispo_total, "photo") %>
              </p>
            <% end %>
            <%= link_to "View the Full Gallery →", dispo_gallery_path, class: "btn-wedding-primary" %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
