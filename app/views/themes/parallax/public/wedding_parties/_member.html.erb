<% delay_class = ["", "animation-delay-200", "animation-delay-400"][index % 3] %>
<% group = local_assigns.fetch(:group, "bridesmaids") %>

<div class="animate-on-scroll <%= delay_class %>" data-scroll-animate-target="item">
  <%= editor_panel("wedding_party") do %>
    <div class="parallax-portrait">
      <div class="parallax-portrait__photo">
        <% if (src = wedding_asset_url(current_wedding.party_member_image(person))).present? %>
          <%= image_tag src, alt: person["name"], loading: "lazy" %>
        <% else %>
          <div class="parallax-portrait__fallback"><%= person["name"].to_s.first %></div>
        <% end %>
      </div>
    </div>

    <div class="mt-8 text-center">
      <%= editor_text("wedding_party.#{group}.#{index}.role", tag: :p, css_class: "parallax-details__label") do %>
        <%= person["role"] %>
      <% end %>
      <%= editor_text("wedding_party.#{group}.#{index}.name", tag: :h3, css_class: "parallax-party__name") do %>
        <%= person["name"] %>
      <% end %>
      <%= editor_text("wedding_party.#{group}.#{index}.relation", tag: :p, css_class: "text-sm font-light italic text-ink-soft") do %>
        <%= person["relation"] %>
      <% end %>
    </div>
  <% end %>
</div>
