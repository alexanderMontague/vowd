<%
  layers = floating_photo_layers(local_assigns.fetch(:assets, []))
  slot_key = local_assigns[:slot]
%>
<% inner = capture do %>
  <% if layers.any? %>
    <div class="floating-photos atelier-floaters" aria-hidden="true" data-controller="parallax">
      <% layers.each_with_index do |(asset, speed), index| %>
        <figure class="floating-photo atelier-floater floating-photo--<%= index + 1 %>"
          data-parallax-target="layer" data-parallax-speed="<%= speed %>">
          <%= image_tag wedding_asset_url(asset), alt: "", loading: "lazy", decoding: "async" %>
        </figure>
      <% end %>
    </div>
  <% end %>
<% end %>
<% if slot_key.present? %>
  <%= editor_slot(slot_key, css_class: "floating-photos-editor-hit") { inner } %>
<% else %>
  <%= inner %>
<% end %>
