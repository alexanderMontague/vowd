<%
  floating_assets = Array(local_assigns[:floating_assets])
  floating_slot = local_assigns[:floating_slot]
%>
<div class="invitation-frame-shell mx-auto max-w-2xl">
  <%= render decor_partial("floating_photos"), assets: floating_assets, slot: floating_slot %>

  <div class="pointer-events-none absolute -inset-4 hidden lg:block" aria-hidden="true">
    <div class="atelier-motif atelier-motif--fan absolute -left-16 top-20 w-28 opacity-90">
      <%= theme_ornament("atelier", "deco-fan") %>
    </div>
    <div class="atelier-motif atelier-motif--fan absolute -right-14 bottom-28 w-28 scale-x-[-1] opacity-85">
      <%= theme_ornament("atelier", "deco-fan") %>
    </div>
  </div>

  <div class="invitation-frame atelier-frame relative z-10">
    <div class="atelier-frame__corner atelier-frame__corner--tl" aria-hidden="true">
      <%= theme_ornament("atelier", "deco-corner") %>
    </div>
    <div class="atelier-frame__corner atelier-frame__corner--tr" aria-hidden="true">
      <%= theme_ornament("atelier", "deco-corner") %>
    </div>
    <div class="atelier-frame__corner atelier-frame__corner--bl" aria-hidden="true">
      <%= theme_ornament("atelier", "deco-corner") %>
    </div>
    <div class="atelier-frame__corner atelier-frame__corner--br" aria-hidden="true">
      <%= theme_ornament("atelier", "deco-corner") %>
    </div>

    <div class="invitation-frame-content relative z-10">
      <div class="atelier-frame__rule mb-8" aria-hidden="true">
        <%= theme_ornament("atelier", "sunburst-rule") %>
      </div>
      <%= yield %>
      <div class="atelier-frame__rule mt-8" aria-hidden="true">
        <%= theme_ornament("atelier", "deco-bar") %>
      </div>
    </div>
  </div>
</div>
