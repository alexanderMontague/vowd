<%# Coastal Mediterranean masthead — garland and wave rules, airy type. %>
<section class="riviera-page-header px-4 py-16 md:py-28">
  <div class="mx-auto max-w-3xl text-center animate-fade-in-up">
    <div class="riviera-page-header__garland mb-8" aria-hidden="true">
      <%= theme_ornament("riviera", "lemon-sprig") %>
    </div>
    <% if local_assigns[:title_field].present? %>
      <%= editor_text(title_field, tag: :h1, css_class: "riviera-page-title") do %>
        <%= title %>
      <% end %>
    <% else %>
      <h1 class="riviera-page-title"><%= title %></h1>
    <% end %>
    <% if local_assigns[:subtitle].present? || (site_editor_active? && local_assigns[:subtitle_field].present?) %>
      <% if local_assigns[:subtitle_field].present? %>
        <%= editor_text(subtitle_field, tag: :p, css_class: "riviera-page-subtitle") do %>
          <%= subtitle %>
        <% end %>
      <% elsif local_assigns[:subtitle].present? %>
        <p class="riviera-page-subtitle"><%= subtitle %></p>
      <% end %>
    <% end %>
    <div class="riviera-page-header__wave mt-8 opacity-70" aria-hidden="true">
      <%= theme_ornament("riviera", "citrus-wave") %>
    </div>
  </div>
</section>
