<%
  asset = local_assigns[:asset]
  caption = local_assigns[:caption]
  wrapper_class = local_assigns.fetch(:wrapper_class, "")
  slot_key = local_assigns[:slot]
%>
<% inner = capture do %>
  <% if asset.present? %>
    <figure class="garden-portrait <%= wrapper_class %>">
      <%= image_tag wedding_asset_url(asset),
          class: "garden-portrait__image",
          alt: wedding_asset_alt(asset), loading: "lazy", decoding: "async" %>
      <%= theme_ornament("garden", "wreath-frame", css_class: "garden-portrait__frame") %>
      <% if caption.present? %>
        <figcaption class="garden-portrait__caption"><%= caption %></figcaption>
      <% end %>
    </figure>
  <% end %>
<% end %>
<% if slot_key.present? %>
  <%= editor_slot(slot_key, css_class: wrapper_class) { inner } %>
<% else %>
  <%= inner %>
<% end %>
