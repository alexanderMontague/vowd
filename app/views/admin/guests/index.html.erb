<%= render "admin/guests/hub_nav" %>

<% actions = capture do %>
  <%= link_to "Export CSV", export_admin_guests_path(format: :csv), class: "btn btn-secondary" %>
  <%= link_to "Add household", new_admin_household_path, class: "btn btn-primary" %>
<% end %>
<%= render "admin/shared/page_header",
    title: "Guests",
    subtitle: "Guest list, households, and RSVP status.",
    actions: actions %>

<div class="card">
  <%= form_with url: admin_guests_path, method: :get, class: "filter-form",
                data: { controller: "form-auto-submit" } do |f| %>
    <div class="form-group mb-0 min-w-[200px]">
      <%= f.label :household_id, "Household" %>
      <%= f.collection_select :household_id, @households, :id, :display_name,
                             { include_blank: "All households" },
                             { class: "form-control", data: { action: "change->form-auto-submit#submit" } } %>
    </div>

    <div class="form-group mb-0 min-w-[150px]">
      <%= f.label :rsvp_status, "RSVP" %>
      <%= f.select :rsvp_status,
                   [["All", ""], ["Pending", "pending"], ["Accepted", "accepted"], ["Declined", "declined"]],
                   {},
                   { class: "form-control", data: { action: "change->form-auto-submit#submit" } } %>
    </div>
  <% end %>

  <% if @guests.any? %>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Household</th>
            <th>RSVP</th>
            <th>Invite code</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @guests.each do |guest| %>
            <tr>
              <td><%= guest.full_name %></td>
              <td><%= guest.email %></td>
              <td><%= link_to guest.household.display_name, edit_admin_household_path(guest.household), class: "text-secondary underline" %></td>
              <td>
                <span class="<%= guest.rsvp.accepted? ? 'text-success' : guest.rsvp.declined? ? 'text-danger' : 'text-warning' %>">
                  <%= guest.rsvp.status.capitalize %>
                </span>
              </td>
              <td><code><%= guest.invite_code %></code></td>
              <td class="actions">
                <%= link_to "Edit", edit_admin_guest_path(guest), class: "btn btn-secondary btn-sm" %>
                <%= button_to "Delete", admin_guest_path(guest), method: :delete,
                              data: { turbo_confirm: "Are you sure?" }, class: "btn btn-danger btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "admin/shared/empty_state", message: "No guests yet. Add a household to get started." %>
  <% end %>
</div>
