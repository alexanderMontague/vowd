<% setup_mode = !@wedding.configured? %>
<% subdomain_host = AppHost.subdomain_host(@wedding.id) %>

<% if setup_mode %>
  <div class="max-w-2xl">
    <div class="admin-page-header">
      <h1>Set up your wedding</h1>
      <p>Tell us the essentials. Everything else unlocks after this.</p>
    </div>

    <div class="admin-setup-checklist card mb-6">
      <p class="admin-setup-checklist-title">Required to continue</p>
      <ul class="admin-setup-checklist-items">
        <li class="<%= @wedding.partner1.present? ? 'is-done' : '' %>">Partner 1 name</li>
        <li class="<%= @wedding.partner2.present? ? 'is-done' : '' %>">Partner 2 name</li>
        <li class="<%= @wedding.date.present? ? 'is-done' : '' %>">Wedding date</li>
      </ul>
    </div>

    <% if @wedding.errors.any? %>
      <div class="alert alert-error mb-6">
        <h3><%= pluralize(@wedding.errors.count, "error") %> prohibited this wedding from being saved:</h3>
        <ul>
          <% @wedding.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @wedding, url: admin_website_path, method: :patch do |f| %>
      <div class="card mb-6">
        <%= render "admin/website/essentials_fields", f: f %>
      </div>

      <%= f.submit "Save & continue", class: "btn btn-primary" %>
    <% end %>
  </div>
<% else %>
  <div class="max-w-3xl">
    <div class="admin-page-header">
      <h1>Wedding</h1>
      <p>
        Essentials and logistics for
        <a href="<%= root_url(host: subdomain_host) %>" class="text-secondary underline" target="_blank" rel="noopener">
          <%= subdomain_host %>
        </a>.
        Site pages and look are edited under
        <%= link_to "Theme", admin_theme_section_path(section: ThemeSections::DEFAULT_KEY), class: "text-secondary underline" %>.
      </p>
    </div>

    <% if @wedding.errors.any? %>
      <div class="alert alert-error mb-6">
        <h3><%= pluralize(@wedding.errors.count, "error") %> prohibited this wedding from being saved:</h3>
        <ul>
          <% @wedding.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="admin-editor">
      <aside class="admin-editor-nav" aria-label="Wedding sections">
        <% WebsiteSections.definitions.each do |section| %>
          <%= link_to section.label,
              admin_website_section_path(section: section.key),
              class: class_names("admin-editor-nav-link", "admin-editor-nav-link-active" => section.key == @section.key) %>
        <% end %>
      </aside>

      <%= form_with model: @wedding,
          url: admin_website_section_path(section: @section.key),
          method: :patch,
          class: "admin-editor-body" do |f| %>
        <div class="card mb-6">
          <%= render "admin/website/sections/#{@section.key}", f: f, wedding: @wedding, subdomain_host: subdomain_host %>
        </div>

        <div class="flex items-center gap-3">
          <%= f.submit "Save changes", class: "btn btn-primary" %>
          <p class="text-xs text-muted">Changes apply immediately.</p>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
