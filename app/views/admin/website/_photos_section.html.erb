<%
  index = local_assigns.fetch(:index)
  section = local_assigns.fetch(:section, {})
  prefix = "wedding[photos_page][sections][#{index}]"
  assets = local_assigns.fetch(:assets, [])
  legacy_images = Array(section["images"]).select { |image| image["url"].present? }
%>
<div class="admin-nested-row" data-nested-form-target="item" data-usage-scope>
  <div class="flex justify-between items-start mb-3">
    <p class="text-sm font-medium text-neutral-700">Section</p>
    <button type="button" class="text-sm text-danger" data-action="nested-form#remove">Remove section</button>
  </div>

  <div class="form-group">
    <label>Section title</label>
    <input type="text" name="<%= prefix %>[title]" value="<%= section["title"] %>" class="form-control"
      placeholder="Engagement, Memories, …"
      data-usage-title data-action="input->asset-picker#refreshUsage">
  </div>

  <div class="form-group mb-0">
    <label>Photos in this section</label>
    <%= render "admin/website/asset_picker",
        field_name: "#{prefix}[asset_ids][]",
        assets: assets,
        usage_prefix: "Photos page",
        empty_text: "No photos in this section yet." %>
  </div>

  <%# Images added before the photo library existed and only ever had an external url. %>
  <% legacy_images.each_with_index do |image, image_index| %>
    <%= hidden_field_tag "#{prefix}[images][#{image_index}][url]", image["url"], id: nil %>
    <%= hidden_field_tag "#{prefix}[images][#{image_index}][alt]", image["alt"], id: nil %>
  <% end %>
</div>
