<%
  assets = local_assigns.fetch(:assets)
  bulk_form_id = local_assigns.fetch(:bulk_form_id, "photo_library_bulk_delete")
%>
<div class="admin-photo-library"
  data-controller="gallery-lightbox photo-library multi-asset-upload bulk-checkboxes"
  data-multi-asset-upload-purpose-value="photos"
  data-multi-asset-upload-url-value="<%= admin_website_assets_path %>"
  data-bulk-checkboxes-checkbox-selector-value=".library-select-checkbox"
  data-bulk-checkboxes-require-selection-value="true">

  <div class="admin-photo-library__header">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Photo library</p>
      <p class="mb-0 text-sm text-neutral-500">
        Upload every photo here once, then choose where each one appears.
      </p>
    </div>
    <label class="btn btn-sm btn-secondary mb-0 cursor-pointer">
      Upload photos
      <input type="file" accept="image/jpeg,image/png,image/webp" multiple class="hidden"
        data-multi-asset-upload-target="input" data-action="change->multi-asset-upload#upload">
    </label>
  </div>

  <div class="admin-photo-library__toolbar">
    <label class="admin-photo-select-all">
      <input type="checkbox"
        data-bulk-checkboxes-target="master"
        data-action="change->bulk-checkboxes#syncFromMaster"
        aria-label="Select all photos">
      Select all
    </label>
    <span class="text-muted text-sm">
      <strong data-bulk-checkboxes-target="count">0</strong> selected
    </span>
    <button type="submit"
      form="<%= bulk_form_id %>"
      class="btn btn-danger btn-sm"
      data-turbo-confirm="Delete the selected photos? They will disappear from every section and page using them."
      data-bulk-checkboxes-target="submit"
      disabled>
      Delete selected
    </button>
  </div>

  <div class="admin-upload-progress mb-3" hidden data-multi-asset-upload-target="progress">
    <div class="admin-upload-progress__track">
      <div class="admin-upload-progress__bar" data-multi-asset-upload-target="progressBar"></div>
    </div>
    <p class="admin-upload-progress__status" data-multi-asset-upload-target="status"></p>
  </div>

  <div class="admin-photo-library__grid" id="photo_library">
    <%= render partial: "admin/website/library_asset",
        collection: assets,
        as: :asset,
        locals: { bulk_form_id: bulk_form_id } %>
  </div>

  <p class="admin-photo-library__empty">
    No photos yet. Upload a few and they become available to the hero, party, and every page.
  </p>

  <dialog class="admin-gallery-lightbox" data-gallery-lightbox-target="dialog" data-action="click->gallery-lightbox#backdropClose">
    <button type="button" class="admin-gallery-lightbox__close" aria-label="Close" data-action="gallery-lightbox#close">&times;</button>
    <figure class="admin-gallery-lightbox__figure">
      <img src="" alt="" class="admin-gallery-lightbox__image" data-gallery-lightbox-target="image">
      <figcaption class="admin-usage-overlay" data-asset-id=""
        data-gallery-lightbox-target="usage" data-asset-picker-target="usage"></figcaption>
    </figure>
  </dialog>
</div>
