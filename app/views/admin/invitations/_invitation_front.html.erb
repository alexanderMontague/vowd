<%
  theme = current_wedding.site_theme
  ceremony_time_val = current_wedding.ceremony_time.is_a?(Hash) ? current_wedding.ceremony_time["time"] : current_wedding.ceremony_time
%>

<div class="invitation-front invitation-panel"
     style="<%= theme.style_attribute %>; --font-display: var(--theme-font-display); --font-body: var(--theme-font-body);">
  <div class="invitation-panel__bg" aria-hidden="true"></div>
  <div class="absolute top-0 left-0 w-12 h-12 overflow-hidden pointer-events-none">
    <%= render "botanical_accent", placement: "top-left", size: "sm" %>
  </div>
  <div class="invitation-panel__body">
    <div class="invitation-panel__top">
      <p class="invitation-kicker">To <%= household.display_name %></p>
      <div class="flex justify-between items-start gap-3">
        <div class="wedding-divider h-6"></div>
        <p class="invitation-eyebrow text-right max-w-[55%]">you are invited to the wedding of</p>
      </div>
    </div>

    <h2 class="invitation-title"><%= current_wedding.title %></h2>

    <div class="invitation-details">
      <% if current_wedding.date %>
        <p><%= format_date_invitation(current_wedding.date) %></p>
      <% end %>
      <% if ceremony_time_val.present? %>
        <p>at <%= ceremony_time_val.downcase %></p>
      <% end %>
      <% if current_wedding.venue.present? %>
        <p><%= current_wedding.venue["name"] %></p>
        <p class="invitation-details__muted"><%= full_venue_name(current_wedding.venue) %></p>
      <% end %>
    </div>

    <p class="invitation-footer">reception to follow</p>
  </div>
  <div class="absolute bottom-0 right-0 w-12 h-12 overflow-hidden pointer-events-none">
    <%= render "botanical_accent", placement: "bottom-right", size: "sm" %>
  </div>
</div>
