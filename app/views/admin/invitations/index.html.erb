<%= render "admin/guests/hub_nav" %>

<nav class="admin-hub-nav" aria-label="Invitation channels">
  <%= link_to "Send by email", admin_invitations_path,
      class: class_names("admin-hub-nav-link", "admin-hub-nav-link-active" => request.path == admin_invitations_path) %>
  <%= link_to "Physical", physical_admin_invitations_path,
      class: class_names("admin-hub-nav-link", "admin-hub-nav-link-active" => request.path.start_with?(physical_admin_invitations_path)) %>
</nav>

<%= render "admin/shared/page_header",
    title: "Send invitations",
    subtitle: "Email RSVP links to guests who haven’t received one yet." %>

<div class="card">
  <div class="stats-grid stats-grid--compact mb-5">
    <div class="stat-card">
      <div class="stat-value"><%= @invitation_stats[:total_guests] %></div>
      <div class="stat-label">Total guests</div>
    </div>

    <div class="stat-card">
      <div class="stat-value"><%= @invitation_stats[:sent] %></div>
      <div class="stat-label">Invitations sent</div>
    </div>

    <div class="stat-card">
      <div class="stat-value"><%= @invitation_stats[:pending] %></div>
      <div class="stat-label">Pending</div>
    </div>

    <div class="stat-card">
      <div class="stat-value"><%= @invitation_stats[:opened] %></div>
      <div class="stat-label">Opened</div>
    </div>
  </div>

  <%= form_with url: admin_invitations_path, method: :post,
                data: {
                  controller: "bulk-checkboxes",
                  bulk_checkboxes_checkbox_selector_value: ".guest-checkbox"
                } do |f| %>
    <table>
      <thead>
        <tr>
          <th class="w-12">
            <input type="checkbox" id="select-all" data-bulk-checkboxes-target="master" aria-label="Select all guests">
          </th>
          <th>Guest</th>
          <th>Email</th>
          <th>Household</th>
          <th>Status</th>
          <th>Last Sent</th>
        </tr>
      </thead>
      <tbody>
        <% @guests.each do |guest| %>
          <tr>
            <td>
              <%= check_box_tag "guest_ids[]", guest.id, false, class: "guest-checkbox" %>
            </td>
            <td><%= guest.full_name %></td>
            <td><%= guest.email %></td>
            <td><%= guest.household.display_name %></td>
            <td>
              <% last_invitation = guest.invitations.last %>
              <span class="<%= last_invitation&.status == 'sent' ? 'text-success' : 'text-warning' %>">
                <%= last_invitation&.status&.capitalize || "Not Sent" %>
              </span>
            </td>
            <td>
              <%= guest.invitations.sent.last&.sent_at&.strftime("%b %d, %Y") || "Never" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="mt-8">
      <%= f.submit "Send Invitations to Selected", class: "btn btn-primary",
                   data: { turbo_confirm: "Send invitations to selected guests?" } %>
    </div>
  <% end %>
</div>
