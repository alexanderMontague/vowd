<%= render layout: "admin/website/hub", locals: { active: "events" } do %>
  <div class="card">
    <div class="admin-page-header mb-4">
      <div class="admin-page-header__title">
        <h2 class="card-header mb-0">Events</h2>
      </div>
      <div class="admin-page-header__actions">
        <%= link_to "New event", new_admin_event_path, class: "btn btn-primary btn-sm" %>
      </div>
    </div>

    <% if @events.any? %>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Date &amp; time</th>
              <th>Location</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @events.each do |event| %>
              <tr>
                <td><%= event.name %></td>
                <td><%= event.datetime&.strftime("%B %d, %Y at %I:%M %p") || "TBD" %></td>
                <td><%= event.location %></td>
                <td class="actions">
                  <%= link_to "Edit", edit_admin_event_path(event), class: "btn btn-secondary btn-sm" %>
                  <%= button_to "Delete", admin_event_path(event), method: :delete,
                                data: { turbo_confirm: "Are you sure?" }, class: "btn btn-danger btn-sm" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= render "admin/shared/empty_state", message: "No events scheduled yet." %>
    <% end %>
  </div>
<% end %>
