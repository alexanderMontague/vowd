<div class="max-w-3xl">
  <%= render "admin/shared/page_header",
      title: "Billing",
      subtitle: "One Wedding Pass for this site — hosted for as long as you want it." %>

  <% if params[:checkout] == "success" %>
    <div class="alert alert-success mb-6">
      Payment received. If status has not updated yet, refresh in a moment while Stripe confirms.
    </div>
  <% elsif params[:checkout] == "canceled" %>
    <div class="alert alert-warning mb-6">
      Checkout canceled. You can try again whenever you are ready.
    </div>
  <% end %>

  <% if current_wedding.billing_requires_payment? %>
    <div class="alert alert-warning mb-6">
      Your trial has ended and the guest site is offline until you complete checkout.
    </div>
  <% end %>

  <div class="card mb-6">
    <h2 class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-4">
      Current plan
    </h2>

    <dl class="space-y-3 text-sm">
      <div class="flex items-baseline justify-between gap-4">
        <dt class="text-neutral-500">Status</dt>
        <dd>
          <span class="badge <%= billing_status_badge_class(current_wedding.billing_status) %>">
            <%= current_wedding.billing_status.humanize %>
          </span>
        </dd>
      </div>

      <% if current_wedding.trial_ends_at.present? %>
        <div class="flex items-baseline justify-between gap-4">
          <dt class="text-neutral-500">Trial ends</dt>
          <dd class="text-neutral-800 font-medium">
            <%= l(current_wedding.trial_ends_at.in_time_zone(current_wedding.timezone), format: :long) %>
            <% if @trial_days_remaining %>
              <span class="text-neutral-400 font-normal">(<%= @trial_days_remaining %> days left)</span>
            <% end %>
          </dd>
        </div>
      <% end %>

      <% if current_wedding.billing_status == "active" %>
        <div class="flex items-baseline justify-between gap-4">
          <dt class="text-neutral-500">Hosting</dt>
          <dd class="text-neutral-800 font-medium">Lifetime for this wedding</dd>
        </div>
      <% end %>
    </dl>
  </div>

  <div class="card mb-6">
    <h2 class="mb-2 text-lg font-medium text-neutral-800">Vowd Wedding Pass</h2>
    <p class="mb-6 text-sm text-muted">
      A one-time fee for this wedding only: guest site, RSVPs, theme editor, party tools,
      and disposable camera — hosted forever after payment. Schedule and venue details
      lock 24 hours before the ceremony so the pass stays tied to this event.
    </p>

    <% if @billing_enabled %>
      <div class="flex flex-wrap gap-3">
        <% if current_wedding.billing_status != "active" %>
          <%= button_to "Continue to checkout",
                checkout_admin_billing_path,
                method: :post,
                class: "btn btn-primary" %>
        <% end %>

        <% if current_wedding.stripe_customer_id.present? %>
          <%= button_to "Billing receipts",
                portal_admin_billing_path,
                method: :post,
                class: "btn btn-secondary" %>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-neutral-500 mb-0">
        Stripe is not configured in this environment. Set
        <code class="text-xs">STRIPE_SECRET_KEY</code> and
        <code class="text-xs">STRIPE_PRICE_ID</code> to enable checkout.
      </p>
    <% end %>
  </div>
</div>
