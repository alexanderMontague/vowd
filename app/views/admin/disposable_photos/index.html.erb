<%= render "admin/disposable_camera/hub_nav" %>

<% actions = capture do %>
  <%= button_to "Delete all",
                destroy_all_admin_disposable_photos_path,
                method: :delete,
                data: { turbo_confirm: "Delete every disposable photo for this wedding? This cannot be undone." },
                class: "btn btn-danger btn-sm" %>
<% end %>
<%= render "admin/shared/page_header",
    title: "Gallery",
    subtitle: "#{pluralize(@photos.size, "guest photo")} from the disposable camera.",
    actions: actions %>

<div class="card">
  <% if @photos.empty? %>
    <%= render "admin/shared/empty_state", message: "No guest photos yet. Share the camera sign so guests can start snapping." %>
  <% else %>
    <%= form_with url: destroy_selected_admin_disposable_photos_path, method: :delete, local: true,
                  data: {
                    controller: "bulk-checkboxes",
                    bulk_checkboxes_checkbox_selector_value: ".photo-select-checkbox",
                    bulk_checkboxes_require_selection_value: true
                  } do %>
      <div class="admin-photo-controls">
        <span class="text-muted">
          <strong data-bulk-checkboxes-target="count">0</strong> selected
        </span>
        <button type="submit"
                class="btn btn-danger btn-sm"
                data-turbo-confirm="Delete the selected photos? This cannot be undone."
                data-bulk-checkboxes-target="submit"
                disabled>
          Delete Selected
        </button>
      </div>

      <section class="admin-photo-grid">
        <% @photos.each do |photo| %>
          <article class="admin-photo-card">
            <label class="admin-photo-checkbox">
              <input
                type="checkbox"
                name="photo_ids[]"
                value="<%= photo.id %>"
                class="photo-select-checkbox"
              >
              Select
            </label>
            <img
              src="<%= DisposableCamera::StorageClient.public_url_for(photo.object_key) %>"
              alt="Disposable camera photo"
              loading="lazy"
            >
            <dl class="admin-photo-meta">
              <div>
                <dt>Captured</dt>
                <dd><%= photo.captured_at.in_time_zone("America/Los_Angeles").strftime("%b %-d, %Y %l:%M %p") %></dd>
              </div>
              <div>
                <dt>Uploaded By</dt>
                <dd><%= photo.guest&.full_name || "Unknown guest" %></dd>
              </div>
              <div>
                <dt>Size</dt>
                <dd><%= number_to_human_size(photo.byte_size) %></dd>
              </div>
              <div>
                <dt>Type</dt>
                <dd><%= photo.content_type %></dd>
              </div>
              <div>
                <dt>Flash</dt>
                <dd><%= photo.flash_enabled? ? "On" : "Off" %></dd>
              </div>
              <div>
                <dt>IP</dt>
                <dd><%= photo.source_ip.presence || "Unknown" %></dd>
              </div>
            </dl>
          </article>
        <% end %>
      </section>
    <% end %>
  <% end %>
</div>
