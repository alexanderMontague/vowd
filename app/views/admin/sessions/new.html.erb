<h1 class="text-center text-secondary mb-card">Admin Login</h1>

<%= form_with url: admin_login_path, method: :post do |f| %>
  <div class="form-group">
    <%= f.label :email %>
    <%= f.email_field :email, class: "form-control", required: true, autofocus: true, autocomplete: "email" %>
  </div>

  <div class="form-group">
    <div class="flex items-center justify-between gap-4">
      <%= f.label :password %>
      <%= link_to "Forgot password?",
            AppHost.absolute_url(host: AppHost.base_domain, path: "/forgot-password"),
            class: "text-sm font-medium text-primary no-underline hover:underline" %>
    </div>
    <%= f.password_field :password, class: "form-control", required: true, autocomplete: "current-password" %>
  </div>

  <%= f.submit "Login", class: "btn btn-primary" %>
<% end %>
