<%
  preview_path = local_assigns.fetch(:preview_path) { root_path }
  show_skip_video = local_assigns.fetch(:show_skip_video, false)
%>
<section class="theme-preview theme-preview--canvas">
  <header class="theme-preview__bar">
    <p class="theme-preview__label">Preview</p>

    <div class="theme-preview__tools">
      <button type="button"
              class="theme-preview__device"
              data-theme-editor-target="deviceButton"
              data-action="theme-editor#setDevice"
              data-device="desktop"
              aria-label="Desktop preview"
              title="Desktop">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75">
          <rect x="3" y="4" width="18" height="12" rx="1.5"/>
          <path d="M8 20h8M12 16v4"/>
        </svg>
      </button>

      <button type="button"
              class="theme-preview__device"
              data-theme-editor-target="deviceButton"
              data-action="theme-editor#setDevice"
              data-device="tablet"
              aria-label="Tablet preview"
              title="Tablet">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75">
          <rect x="5" y="2" width="14" height="20" rx="2"/>
          <path d="M11 18h2"/>
        </svg>
      </button>

      <button type="button"
              class="theme-preview__device"
              data-theme-editor-target="deviceButton"
              data-action="theme-editor#setDevice"
              data-device="mobile"
              aria-label="Mobile preview"
              title="Mobile">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75">
          <rect x="7" y="2" width="10" height="20" rx="2"/>
          <path d="M11 18h2"/>
        </svg>
      </button>

      <span class="theme-preview__tools-divider" aria-hidden="true"></span>

      <button type="button"
              class="theme-preview__device"
              data-action="theme-editor#reload"
              aria-label="Reload preview"
              title="Reload">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75">
          <path d="M21 12a9 9 0 1 1-2.6-6.4"/>
          <path d="M21 3v6h-6"/>
        </svg>
      </button>

      <span class="theme-preview__tools-divider" aria-hidden="true"></span>

      <label class="theme-preview__skip-video"
             data-theme-editor-target="skipVideoControl"
             <%= "hidden" unless show_skip_video %>>
        <input type="checkbox"
               data-theme-editor-target="skipVideo"
               data-action="theme-editor#toggleSkipVideo">
        <span>Skip intro</span>
      </label>

      <button type="button"
              class="theme-preview__settings"
              data-action="theme-editor#openSettings"
              aria-label="Settings"
              title="Settings">
        Settings
      </button>
    </div>
  </header>

  <div class="theme-preview__stage" data-theme-editor-target="frameStage">
    <div class="theme-preview__loading" data-theme-editor-target="frameLoading" hidden>
      <div class="theme-preview__skeleton" aria-hidden="true">
        <div class="theme-preview__skeleton-bar theme-preview__skeleton-bar--nav"></div>
        <div class="theme-preview__skeleton-hero"></div>
        <div class="theme-preview__skeleton-bar theme-preview__skeleton-bar--title"></div>
        <div class="theme-preview__skeleton-bar theme-preview__skeleton-bar--line"></div>
        <div class="theme-preview__skeleton-bar theme-preview__skeleton-bar--line-short"></div>
      </div>
      <p class="theme-preview__loading-label">Updating preview…</p>
    </div>
    <iframe src="<%= preview_path %>"
            title="Guest site preview"
            class="theme-preview__frame"
            data-theme-editor-target="frame"></iframe>
  </div>
</section>
