<section class="card mb-6">
  <h2 class="admin-editor-panel-title">Pages</h2>

  <div class="theme-page-rows">
    <% SitePages.definitions.each do |page| %>
      <% field_id = "theme_pages_#{page.key}" %>

      <div class="theme-page-row">
        <div class="theme-page-row__labels">
          <%= label_tag field_id, page.label, class: "theme-page-row__label" %>
        </div>

        <div class="theme-page-row__control">
          <% if page.toggleable %>
            <%= hidden_field_tag "theme[pages][#{page.key}]", "0", id: nil %>
            <%= check_box_tag "theme[pages][#{page.key}]", "1", theme.page_enabled?(page.key),
                  id: field_id,
                  data: { theme_page: page.key, action: "change->theme-editor#commit" } %>
          <% else %>
            <span class="badge badge-neutral">Always on</span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
