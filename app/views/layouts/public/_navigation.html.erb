<% pages = site_navigation.pages %>
<% landing_path = site_page_path(site_navigation.landing_page) %>
<% show_links = pages.many? %>

<nav class="wedding-nav" data-controller="nav">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-24">
      <%= link_to landing_path, class: "flex min-w-0 items-center no-underline" do %>
        <span class="wedding-nav-brand"><%= current_wedding.title %></span>
      <% end %>

      <% if show_links %>
        <div class="hidden md:flex gap-8">
          <% pages.each do |page| %>
            <%= site_page_link(page) %>
          <% end %>
        </div>

        <button class="wedding-nav-toggle" data-action="nav#toggle" aria-label="Toggle navigation">
          <svg data-nav-target="openIcon" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
          </svg>
          <svg data-nav-target="closeIcon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      <% end %>
    </div>
  </div>

  <% if show_links %>
    <div class="md:hidden hidden border-t border-hairline" data-nav-target="menu" data-action="click->nav#close">
      <div class="max-w-7xl mx-auto px-6 py-6 flex flex-col gap-6">
        <% pages.each do |page| %>
          <%= site_page_link(page, css_class: "wedding-nav-link self-start") %>
        <% end %>
      </div>
    </div>
  <% end %>
</nav>
