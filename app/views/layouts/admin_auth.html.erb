<!DOCTYPE html>
<html>
  <head>
    <title>Login - Vowd Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= favicon_link_tag '/favicon.png', type: 'image/png' %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="font-sans m-0 bg-gradient-to-br from-primary-400 to-secondary min-h-screen flex items-center justify-center">
    <div class="bg-bg-card p-12 rounded-xl shadow-2xl w-full max-w-form mx-4">
      <%= yield %>
    </div>

    <%= render "admin/shared/toasts" %>
  </body>
</html>
