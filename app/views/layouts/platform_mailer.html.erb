<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="color-scheme" content="light only">
    <meta name="supported-color-schemes" content="light only">
    <title>Vowd</title>
    <style>
      body { margin: 0; padding: 0; width: 100% !important; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; background-color: #f2f3f6; }
      table { border-collapse: collapse; }
      img { border: 0; line-height: 100%; outline: none; text-decoration: none; }
      a { color: #2b5f52; }

      .platform-sans { font-family: -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; }

      @media only screen and (max-width: 620px) {
        .platform-card-pad { padding-left: 28px !important; padding-right: 28px !important; }
        .platform-display { font-size: 28px !important; line-height: 1.2 !important; }
      }
    </style>
  </head>
  <body style="margin:0; padding:0; background-color:#f2f3f6;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f2f3f6;">
      <tr>
        <td align="center" style="padding: 40px 16px;">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px; max-width:600px; background-color:#ffffff; border:1px solid #e5e7ec; border-radius:12px; overflow:hidden;">
            <tr>
              <td style="height:4px; line-height:4px; font-size:0; background-color:#2b5f52;">&nbsp;</td>
            </tr>

            <tr>
              <td class="platform-card-pad platform-sans" align="center" style="padding: 36px 48px 0; font-family:-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
                <div style="font-size:13px; font-weight:600; letter-spacing:-0.02em; color:#12151a;">
                  Vowd
                </div>
              </td>
            </tr>

            <tr>
              <td class="platform-card-pad platform-sans" style="padding: 28px 48px 8px; font-family:-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; color:#3f4654;">
                <%= yield %>
              </td>
            </tr>

            <tr>
              <td class="platform-card-pad platform-sans" style="padding: 24px 48px 40px; font-family:-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
                <div style="border-top:1px solid #e5e7ec; padding-top:24px; text-align:center;">
                  <% if @wedding&.title.present? %>
                    <div style="font-size:14px; font-weight:600; letter-spacing:-0.01em; color:#12151a;">
                      <%= @wedding.title %>
                    </div>
                  <% end %>
                  <div style="margin-top:8px; font-size:12px; font-weight:400; line-height:1.6; color:#9aa1b0;">
                    Wedding websites for modern couples
                  </div>
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
