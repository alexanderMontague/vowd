<!DOCTYPE html>
<html>
  <head>
    <title>Admin - Vowd</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= favicon_link_tag '/favicon.png', type: 'image/png' %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>

  <body class="admin-app m-0">
    <div class="admin-shell" data-controller="admin-nav">
      <header class="admin-topbar print:hidden">
        <button type="button"
                class="admin-topbar-toggle"
                data-action="admin-nav#open"
                aria-label="Open menu">
          <span class="admin-topbar-toggle__bars" aria-hidden="true"></span>
        </button>
        <%= link_to "Vowd", current_wedding&.configured? ? admin_root_path : admin_website_path, class: "admin-topbar-brand" %>
        <% if current_wedding %>
          <p class="admin-topbar-meta"><%= current_wedding.title %></p>
        <% end %>
      </header>

      <div class="admin-nav-backdrop print:hidden"
           data-admin-nav-target="backdrop"
           data-action="click->admin-nav#close"
           hidden></div>

      <aside class="admin-side-nav print:hidden" data-admin-nav-target="panel">
        <div class="admin-side-nav-header">
          <div>
            <%= link_to "Vowd", current_wedding&.configured? ? admin_root_path : admin_website_path, class: "admin-side-nav-brand" %>
            <% if current_wedding %>
              <p class="admin-side-nav-meta"><%= current_wedding.title %></p>
            <% end %>
          </div>
          <button type="button"
                  class="admin-side-nav-close"
                  data-action="admin-nav#close"
                  aria-label="Close menu">
            &times;
          </button>
        </div>

        <nav class="admin-side-nav-links">
          <% if current_wedding&.configured? %>
            <%= admin_nav_link("Dashboard", admin_root_path, exact: true) %>

            <%= admin_nav_section("Website") %>
            <%= admin_nav_link(
                  "Wedding",
                  admin_website_path,
                  active_prefixes: ["/admin/website", admin_events_path]
                ) %>
            <%= admin_nav_link("Theme", admin_theme_section_path(section: ThemeSections::DEFAULT_KEY), active_prefixes: ["/admin/theme"]) %>

            <%= admin_nav_section("Guests") %>
            <%= admin_nav_link(
                  "Guests",
                  admin_guests_path,
                  active_prefixes: [
                    admin_guests_path,
                    admin_households_path,
                    admin_invitations_path,
                    admin_save_the_date_signups_path
                  ]
                ) %>

            <%= admin_nav_section("Planning") %>
            <%= admin_nav_link(
                  "Party planning",
                  admin_party_path,
                  active_prefixes: ["/admin/party"]
                ) %>

            <%= admin_nav_section("Day of") %>
            <%= admin_nav_link(
                  "Disposable camera",
                  admin_disposable_photos_path,
                  active_prefixes: [admin_disposable_photos_path, admin_dispo_sign_path]
                ) %>

            <%= admin_nav_section("System") %>
            <%= admin_nav_link("Feature flags", admin_settings_path, exact: true) %>
            <%= admin_nav_link("Billing", admin_billing_path, exact: true) %>
          <% else %>
            <%= admin_nav_link(
                  "Wedding",
                  admin_website_path,
                  active_prefixes: ["/admin/website", admin_events_path]
                ) %>
            <%= admin_nav_link("Billing", admin_billing_path, exact: true) %>
            <p class="admin-side-nav-hint">
              Add partners and a wedding date to unlock guests, invitations, and day-of tools.
            </p>
          <% end %>

        </nav>

        <%= button_to "Log out", admin_logout_path, method: :delete, class: "btn btn-sm btn-danger w-full mt-auto" %>
      </aside>

      <main class="admin-main <%= content_for(:admin_main_class) %>" data-controller="scroll-preservation">
        <% if Billing.enabled? && current_wedding&.trial_active? && current_wedding.trial_ends_at.present? %>
          <% days_left = [((current_wedding.trial_ends_at - Time.current) / 1.day).ceil, 0].max %>
          <% if days_left <= 7 %>
            <div class="alert alert-warning mb-6 print:hidden">
              Trial ends in <%= days_left %> <%= "day".pluralize(days_left) %>.
              <%= link_to "Choose a plan", admin_billing_path, class: "font-medium underline" %>
            </div>
          <% end %>
        <% elsif Billing.enabled? && current_wedding&.billing_requires_payment? && !controller.is_a?(Admin::BillingController) %>
          <div class="alert alert-warning mb-6 print:hidden">
            Your trial has ended and the guest site is offline.
            <%= link_to "Complete checkout", admin_billing_path, class: "font-medium underline" %>
            to restore it.
          </div>
        <% end %>
        <%= yield %>
      </main>
    </div>

    <%= render "admin/shared/toasts" %>
  </body>
</html>
