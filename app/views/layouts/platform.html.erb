<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Vowd" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= favicon_link_tag '/favicon.png', type: 'image/png' %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% header_light = false %>
  <body class="platform-app m-0 min-h-screen <%= content_for?(:body_class) ? yield(:body_class) : "" %>">
    <header class="platform-header">
      <div class="platform-header__inner">
        <%= link_to "Vowd", platform_root_path, class: "platform-header__brand" %>
        <nav class="platform-header__nav">
          <%= link_to "Log in", platform_login_path, class: "btn btn-secondary btn-sm" %>
          <%= link_to "Sign up", platform_signup_path, class: "btn btn-primary btn-sm" %>
        </nav>
      </div>
    </header>

    <% if flash[:notice] %>
      <div class="platform-flash">
        <div class="alert alert-success"><%= flash[:notice] %></div>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div class="platform-flash">
        <div class="alert alert-error"><%= flash[:alert] %></div>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
