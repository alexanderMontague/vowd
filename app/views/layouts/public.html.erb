<!DOCTYPE html>
<%# The theme's authored tokens land on the root element, where the derived tokens in
    the stylesheet's `:root` block pick them up. `data-theme` opts into that theme's
    scoped layer. %>
<html data-theme="<%= site_theme.key %>"
      style="<%= site_theme.style_attribute %>"
      <% if site_editor_session? %>data-turbo="false"<% end %>>
  <head>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= render "layouts/public/meta_tags" %>
    <%= favicon_link_tag '/favicon.png', type: 'image/png' %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Full document loads while the Theme editor session is open so the
        preview iframe keeps Sec-Fetch-Dest: iframe across nav clicks (Turbo
        Drive would send "empty" and drop editor mode + parent URL sync). %>
    <% if site_editor_session? %>
      <meta name="turbo" content="false">
    <% end %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="<%= site_theme.fonts_href %>" data-theme-fonts>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="wedding-page<%= " site-editor-active" if site_editor_active? %>"
        <% if site_editor_active? %>data-controller="site-editor"<% end %>>
    <%= render "layouts/public/navigation" %>
    <main>
      <%= yield %>
    </main>
    <%= render "layouts/public/footer" unless content_for?(:hide_site_footer) %>
    <%= render "layouts/public/theme_preview_banner" %>
  </body>
</html>
