<p class="platform-sans platform-display" style="margin:0; font-family:-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:32px; font-weight:600; letter-spacing:-0.03em; line-height:1.15; color:#12151a;">
  <% if @days_left <= 1 %>
    Your trial ends tomorrow
  <% else %>
    Your trial ends in <%= @days_left %> days
  <% end %>
</p>

<p class="platform-sans" style="margin:16px 0 0; font-family:-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:15px; font-weight:400; line-height:1.7; color:#737b8c;">
  When the trial ends without a Wedding Pass, the guest site for
  <strong style="font-weight:600; color:#12151a;"><%= @wedding.title %></strong>
  goes offline until you check out.
</p>

<% if @trial_ends_at.present? %>
  <p class="platform-sans" style="margin:20px 0 0; font-family:-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:15px; font-weight:400; line-height:1.7; color:#3f4654;">
    Trial ends
    <strong style="font-weight:600; color:#12151a;"><%= l(@trial_ends_at.in_time_zone(@wedding.timezone), format: :long) %></strong>.
    One payment keeps this wedding’s site hosted forever.
  </p>
<% end %>

<%= render "mailer_shared/platform_button", url: @billing_url, label: "Complete checkout" %>

<p class="platform-sans" style="margin:28px 0 0; font-family:-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:13px; font-weight:400; line-height:1.65; color:#9aa1b0;">
  Already paid? You can ignore this — Stripe may still be confirming.
</p>
