<%#
  Renders a single disposable camera photo with its layered film treatment.
  The original image is served untouched; grain / flash spill / cast / vignette /
  frame-edge layers and the colour grade are applied on the front end. Per-photo
  variation is set by the retro-photo controller; which layers are visible is
  scoped by an ancestor `data-photo-style` attribute.

  Locals:
    photo  - a DisposablePhoto
    square - crop to a square tile (default true); false keeps natural proportions
%>
<% square = local_assigns.fetch(:square, true) %>
<figure class="retro-photo <%= "retro-photo--square" if square %>"
        data-controller="retro-photo"
        data-retro-photo-seed-value="<%= photo.id %>">
  <div class="retro-photo__frame">
    <img class="retro-photo__img"
         src="<%= DisposableCamera::StorageClient.public_url_for(photo.object_key) %>"
         alt="Disposable camera guest photo"
         loading="lazy">
    <span class="retro-photo__grain" aria-hidden="true"></span>
    <span class="retro-photo__leak" aria-hidden="true"></span>
    <span class="retro-photo__cast" aria-hidden="true"></span>
    <span class="retro-photo__vignette" aria-hidden="true"></span>
    <span class="retro-photo__frame-edge" aria-hidden="true"></span>
  </div>
</figure>
