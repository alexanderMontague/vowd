<p class="platform-sans platform-display" style="margin:0; font-family:-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:32px; font-weight:600; letter-spacing:-0.03em; line-height:1.15; color:#12151a;">
  Reset your password
</p>

<p class="platform-sans" style="margin:16px 0 0; font-family:-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:15px; font-weight:400; line-height:1.7; color:#737b8c;">
  We received a request to reset the password for
  <strong style="font-weight:600; color:#12151a;"><%= @admin_user.email %></strong>.
  This link expires in two hours.
</p>

<%= render "mailer_shared/platform_button", url: @reset_url, label: "Reset password" %>

<p class="platform-sans" style="margin:24px 0 0; text-align:center; font-family:-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:12px; font-weight:400; line-height:1.65; color:#9aa1b0;">
  Or copy this link:<br>
  <a href="<%= @reset_url %>" style="color:#2b5f52; text-decoration:none; word-break:break-all;"><%= @reset_url %></a>
</p>

<p class="platform-sans" style="margin:28px 0 0; font-family:-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:13px; font-weight:400; line-height:1.65; color:#9aa1b0;">
  If you did not request this, you can ignore this email. Your password will stay the same.
</p>
