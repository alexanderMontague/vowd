<% content_for :title, "Log in - Vowd" %>

<div class="flex min-h-screen items-center justify-center px-4 py-28">
  <div class="w-full max-w-form rounded-xl bg-bg-card p-10 shadow-2xl">
    <h1 class="mb-card text-center text-secondary">Log in</h1>

    <%= form_with url: platform_login_path, method: :post, data: { turbo: false } do |f| %>
      <div class="form-group">
        <%= f.label :email %>
        <%= f.email_field :email, class: "form-control", required: true, autofocus: true, autocomplete: "email" %>
      </div>

      <div class="form-group">
        <%= f.label :password %>
        <%= f.password_field :password, class: "form-control", required: true, autocomplete: "current-password" %>
      </div>

      <%= f.submit "Log in", class: "btn btn-primary w-full" %>
    <% end %>

    <p class="mb-0 mt-8 text-center text-neutral-500">
      New here?
      <%= link_to "Create an account", platform_signup_path, class: "font-medium text-primary no-underline hover:underline" %>
    </p>
  </div>
</div>
