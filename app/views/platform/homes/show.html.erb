<% content_for :title, "Vowd — Wedding websites for modern couples" %>
<% content_for :body_class, "platform-app" %>

<section class="platform-hero">
  <div class="platform-hero__copy">
    <p class="platform-hero__brand">Vowd</p>
    <h1 class="platform-hero__headline">Wedding websites that feel considered</h1>
    <p class="platform-hero__lede">
      Theme your guest site, manage RSVPs, plan the party, and collect candid photos —
      from one calm admin.
    </p>
    <div class="platform-hero__actions">
      <%= link_to "Create your site", platform_signup_path, class: "btn btn-primary" %>
      <%= link_to "Log in", platform_login_path, class: "btn btn-secondary" %>
    </div>
  </div>

  <div class="platform-browser platform-hero__media">
    <div class="platform-browser-chrome">
      <span class="platform-browser-dot"></span>
      <span class="platform-browser-dot"></span>
      <span class="platform-browser-dot"></span>
      <span class="platform-browser-url">britt-and-alex.vowd.localhost</span>
    </div>
    <%= image_tag "marketing/hero.jpg",
        alt: "Vowd wedding website preview",
        class: "platform-browser__image" %>
  </div>
</section>

<section class="platform-section">
  <div class="platform-section__intro">
    <h2>Everything your guests need — and you need to stay organized</h2>
    <p>Built for couples who want polish without a spreadsheet or a design degree.</p>
  </div>

  <div class="platform-features">
    <article class="platform-feature">
      <div class="platform-browser">
        <div class="platform-browser-chrome">
          <span class="platform-browser-dot"></span>
          <span class="platform-browser-dot"></span>
          <span class="platform-browser-dot"></span>
          <span class="platform-browser-url">/admin/theme</span>
        </div>
        <%= image_tag "marketing/theme.jpg",
            alt: "Theme editor with live preview",
            class: "platform-browser__image" %>
      </div>
      <h3>Theme editor</h3>
      <p>Live preview, click-to-edit copy, photo placements, and look & feel — autosaved as you go.</p>
    </article>

    <article class="platform-feature">
      <div class="platform-browser">
        <div class="platform-browser-chrome">
          <span class="platform-browser-dot"></span>
          <span class="platform-browser-dot"></span>
          <span class="platform-browser-dot"></span>
          <span class="platform-browser-url">/rsvp</span>
        </div>
        <%= image_tag "marketing/rsvp.jpg",
            alt: "Guest RSVP experience",
            class: "platform-browser__image" %>
      </div>
      <h3>RSVP & guests</h3>
      <p>Households, meal choices, invite codes, and a dashboard that shows who’s coming.</p>
    </article>

    <article class="platform-feature">
      <div class="platform-browser">
        <div class="platform-browser-chrome">
          <span class="platform-browser-dot"></span>
          <span class="platform-browser-dot"></span>
          <span class="platform-browser-dot"></span>
          <span class="platform-browser-url">/save-the-date</span>
        </div>
        <%= image_tag "marketing/save-the-date.jpg",
            alt: "Save the date page",
            class: "platform-browser__image" %>
      </div>
      <h3>Save the Date</h3>
      <p>Collect interest early, share calendar downloads, then open full RSVP when you’re ready.</p>
    </article>

    <article class="platform-feature">
      <div class="platform-browser">
        <div class="platform-browser-chrome">
          <span class="platform-browser-dot"></span>
          <span class="platform-browser-dot"></span>
          <span class="platform-browser-dot"></span>
          <span class="platform-browser-url">/admin</span>
        </div>
        <%= image_tag "marketing/admin.jpg",
            alt: "Private admin dashboard",
            class: "platform-browser__image" %>
      </div>
      <h3>Private admin</h3>
      <p>Guests, invitations, reminders, and RSVP insight — only on your wedding host.</p>
    </article>

    <article class="platform-feature">
      <div class="platform-browser">
        <div class="platform-browser-chrome">
          <span class="platform-browser-dot"></span>
          <span class="platform-browser-dot"></span>
          <span class="platform-browser-dot"></span>
          <span class="platform-browser-url">/admin/party</span>
        </div>
        <%= image_tag "marketing/party.jpg",
            alt: "Party planning board",
            class: "platform-browser__image" %>
      </div>
      <h3>Party planning</h3>
      <p>Bachelor and bachelorette boards with people, ideas, itinerary, and destination polls.</p>
    </article>

    <article class="platform-feature">
      <div class="platform-browser">
        <div class="platform-browser-chrome">
          <span class="platform-browser-dot"></span>
          <span class="platform-browser-dot"></span>
          <span class="platform-browser-dot"></span>
          <span class="platform-browser-url">/dispo</span>
        </div>
        <%= image_tag "marketing/gallery.jpg",
            alt: "Disposable camera photo with film treatment",
            class: "platform-browser__image" %>
      </div>
      <h3>Disposable camera</h3>
      <p>Guests snap candid shots from their phones. You get a live gallery with film-style treatments.</p>
    </article>
  </div>
</section>

<section class="platform-band">
  <div class="platform-band__inner">
    <h2>Open source</h2>
    <p>
      Prefer to run it yourself? Vowd is open source — fork the repo, host it on your own machine or VPS,
      and keep full control of your wedding site.
    </p>
    <%= link_to "View on GitHub",
        "https://github.com/alexanderMontague/vowd",
        class: "btn btn-secondary",
        target: "_blank",
        rel: "noopener noreferrer" %>
  </div>
</section>

<section class="platform-cta">
  <div class="platform-cta__inner">
    <h2>Your subdomain. Your day.</h2>
    <p>Sign up, pick a slug, and start configuring — guests visit your site, you run everything from admin.</p>
    <%= link_to "Get started", platform_signup_path, class: "btn btn-primary" %>
  </div>
</section>
